  <environmentvariabledefinitions>
    <environmentvariabledefinition schemaname="pdh_SiteUrl">
      <displayname>Site URL</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Absolute site URL. Passed to the agent as siteUrl and used as the dataset parameter on SharePoint actions.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="pdh_LibraryUrlName">
      <displayname>Library URL Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>The library's URL name, not its display name.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="pdh_SourceRootPath">
      <displayname>Source Root Path</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Server-relative path of the folder holding position folders. The walk starts here.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="pdh_TemplateFolderPath">
      <displayname>Template Folder Path</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
