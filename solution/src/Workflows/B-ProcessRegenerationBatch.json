{
  "$comment": "FLOW B - Process Regeneration Batch. The ONLY flow that invokes the agent and the ONLY flow that writes business documents. Claims a bounded batch, and per document: read, invoke agent, VALIDATE, archive the existing output, write the new output, mark the outcome. That order is not negotiable. See docs/Template-Regeneration-Solution-Design.md section 6.",
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "fi_sharedsharepointonline"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_agentnode": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "fi_sharedagentnode"
        },
        "api": {
          "name": "shared_agentnode"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 15
          },
          "description": "The 15-minute recurrence and fi_BatchSize jointly throttle the 600 calls/min connector limit and agent capacity consumption. Recurrence is a design-time Power Automate setting and is reviewed in source rather than exposed as an ignored environment variable.",
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Reap_stale_claims": {
          "runAfter": {},
          "type": "Scope",
          "description": "Items left InProgress beyond StaleClaimMinutes belong to a run that died. They are parked rather than automatically retried because the agent may have produced side effects before the flow lost its response.",
          "actions": {
            "Get_stale_items": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                  "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                  "$filter": "Status eq 'InProgress' and ClaimedAt lt datetime'@{addMinutes(utcNow(), mul(-1, int(parameters('fi_StaleClaimMinutes (fi_StaleClaimMinutes)'))), 'yyyy-MM-ddTHH:mm:ssZ')}'",
                  "$top": 100
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "For_each_stale_item": {
              "runAfter": {
                "Get_stale_items": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('Get_stale_items')?['value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Release_stale_claim": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                      "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                      "id": "@items('For_each_stale_item')?['ID']",
                      "item/Status/Value": "Failed",
                      "item/ClaimedBy": "",
                      "item/ErrorMessage": "Claim expired. The item was parked for review because the previous run may have produced side effects."
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          }
        },
        "Get_active_run": {
          "runAfter": {
            "Reap_stale_claims": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
              "table": "@parameters('fi_RunListName (fi_RunListName)')",
              "$filter": "(Status eq 'Approved' or Status eq 'Running') and IsDryRun eq 0",
              "$orderby": "Created asc",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Only an approved, non-dry-run run is executable. One run at a time, oldest first - concurrent runs would compete for the same agent capacity and make cost unpredictable."
        },
        "Exit_if_no_active_run": {
          "runAfter": {
            "Get_active_run": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@length(body('Get_active_run')?['value'])",
              0
            ]
          },
          "actions": {
            "Terminate_idle": {
              "runAfter": {},
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Init_ActiveRunId": {
          "runAfter": {
            "Exit_if_no_active_run": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ActiveRunId",
                "type": "string",
                "value": "@{first(body('Get_active_run')?['value'])?['RunId']}"
              }
            ]
          }
        },
        "Init_AgentCalls": {
          "runAfter": {
            "Init_ActiveRunId": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "AgentCallsThisBatch",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "description": "Rolled up into the run's AgentCallCount, the headline cost metric reported by Flow C."
        },
        "Init_Backpressure": {
          "runAfter": {
            "Init_AgentCalls": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "BackpressureHit",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Mark_run_running": {
          "runAfter": {
            "Init_Backpressure": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
              "table": "@parameters('fi_RunListName (fi_RunListName)')",
              "id": "@first(body('Get_active_run')?['value'])?['ID']",
              "item/Status/Value": "Running"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Claim_batch": {
          "runAfter": {
            "Mark_run_running": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
              "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
              "$filter": "RunId eq '@{variables('ActiveRunId')}' and Status eq 'Pending'",
              "$orderby": "ID asc",
              "$top": "@parameters('fi_BatchSize (fi_BatchSize)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "RunId and Status are indexed columns. Without that this query degrades as run history accumulates - the same threshold problem this solution exists to avoid."
        },
        "For_each_work_item": {
          "runAfter": {
            "Claim_batch": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Claim_batch')?['value']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "description": "Sequential by design. Concurrency multiplies capacity burn rate and makes double-processing possible unless claiming is genuinely atomic; change this source setting only after measured tenant testing.",
          "actions": {
            "Skip_if_backpressure": {
              "runAfter": {},
              "type": "If",
              "expression": {
                "equals": [
                  "@variables('BackpressureHit')",
                  true
                ]
              },
              "description": "BACKPRESSURE. Once a throttling or capacity error is seen, stop claiming further work and let the next cycle retry. Retrying hard against a capacity limit converts a delay into a cost.",
              "actions": {},
              "else": {
                "actions": {
                  "Claim_item": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                        "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                        "id": "@items('For_each_work_item')?['ID']",
                        "item/Status/Value": "InProgress",
                        "item/ClaimedBy": "@{workflow()?['run']?['name']}",
                        "item/ClaimedAt": "@utcNow()",
                        "item/AttemptCount": "@add(int(coalesce(items('For_each_work_item')?['AttemptCount'], 0)), 1)"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "description": "Claim BEFORE processing. Without this, two overlapping batches regenerate the same document twice - wrong, and double the cost."
                  },
                  "Process_document": {
                    "runAfter": {
                      "Claim_item": [
                        "Succeeded"
                      ]
                    },
                    "type": "Scope",
                    "description": "Wrapped in a scope so one document's failure never aborts the batch. A single malformed source must not stop 300 others.",
                    "actions": {
                      "COMPOSE_agent_prompt": {
                        "runAfter": {},
                        "type": "Compose",
                        "inputs": "@{concat('Convert this Position Description using the published template.', decodeUriComponent('%0A%0A'), 'siteUrl: ', parameters('fi_SiteAddress (fi_SiteAddress)'), decodeUriComponent('%0A'), 'templatePath: ', items('For_each_work_item')?['TemplateUrl'], decodeUriComponent('%0A'), 'sourcePath: ', items('For_each_work_item')?['SourceUrl'], decodeUriComponent('%0A'), 'runId: ', variables('ActiveRunId'))}",
                        "description": "The deployed skill requires one concrete source PD path and one template file or folder per invocation. Flow A has already selected the preferred file of any PDF/DOCX pair."
                      },
                      "STEP_2_Invoke_agent": {
                        "runAfter": {
                          "COMPOSE_agent_prompt": [
                            "Succeeded"
                          ]
                        },
                        "runtimeConfiguration": {
                          "retryPolicy": {
                            "type": "None"
                          }
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_agentnode",
                            "operationId": "InvokeAgent",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_agentnode"
                          },
                          "parameters": {
                            "body/agentId": "@parameters('fi_AgentId (fi_AgentId)')",
                            "body/prompt": "@outputs('COMPOSE_agent_prompt')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "description": "THE ONLY METERED OPERATION. Connector, operation and parameter names are taken from the working reference export. The existing agent archives displaced files, writes outputs, verifies stored byte counts and returns one JSON report."
                      },
                      "Count_agent_call": {
                        "runAfter": {
                          "STEP_2_Invoke_agent": [
                            "Succeeded",
                            "Failed",
                            "TimedOut"
                          ]
                        },
                        "type": "IncrementVariable",
                        "inputs": {
                          "name": "AgentCallsThisBatch",
                          "value": 1
                        },
                        "description": "Counted whether or not it succeeded because a failed call can still consume capacity."
                      },
                      "Persist_agent_call_count": {
                        "runAfter": {
                          "Count_agent_call": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                            "table": "@parameters('fi_RunListName (fi_RunListName)')",
                            "id": "@first(body('Get_active_run')?['value'])?['ID']",
                            "item/AgentCallCount": "@add(int(coalesce(first(body('Get_active_run')?['value'])?['AgentCallCount'], 0)), variables('AgentCallsThisBatch'))"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "description": "Persist cost immediately after each metered call so a later batch crash cannot erase the count."
                      },
                      "CAPTURE_agent_response": {
                        "runAfter": {
                          "Persist_agent_call_count": [
                            "Succeeded"
                          ]
                        },
                        "type": "Compose",
                        "inputs": "@coalesce(body('STEP_2_Invoke_agent'), '')",
                        "description": "Verbatim connector response retained in run history before parsing."
                      },
                      "EXTRACT_reply_text": {
                        "runAfter": {
                          "CAPTURE_agent_response": [
                            "Succeeded"
                          ]
                        },
                        "type": "Compose",
                        "inputs": "@if(empty(coalesce(body('STEP_2_Invoke_agent')?['text'], body('STEP_2_Invoke_agent')?['response'], body('STEP_2_Invoke_agent')?['output'])), string(outputs('CAPTURE_agent_response')), string(coalesce(body('STEP_2_Invoke_agent')?['text'], body('STEP_2_Invoke_agent')?['response'], body('STEP_2_Invoke_agent')?['output'])))",
                        "description": "Accept a wrapped text/response/output property or a bare JSON object. The fallback checks emptiness before choosing, so an absent wrapper cannot suppress the raw response."
                      },
                      "TRY_parse_agent_report": {
                        "runAfter": {
                          "EXTRACT_reply_text": [
                            "Succeeded"
                          ]
                        },
                        "type": "Scope",
                        "actions": {
                          "PARSE_agent_report": {
                            "runAfter": {},
                            "type": "ParseJson",
                            "inputs": {
                              "content": "@outputs('EXTRACT_reply_text')",
                              "schema": {
                                "type": "object",
                                "required": [
                                  "status",
                                  "reason",
                                  "sourceFile",
                                  "sourceChosenBecause",
                                  "outputs",
                                  "notes"
                                ],
                                "properties": {
                                  "status": {
                                    "type": "string",
                                    "enum": [
                                      "OK",
                                      "FAILED",
                                      "SKIPPED"
                                    ]
                                  },
                                  "reason": {
                                    "type": "string"
                                  },
                                  "sourceFile": {
                                    "type": "string"
                                  },
                                  "sourceChosenBecause": {
                                    "type": "string"
                                  },
                                  "notes": {
                                    "type": "string"
                                  },
                                  "outputs": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "required": [
                                        "template",
                                        "kind",
                                        "destinationFolderPath",
                                        "outputFileName",
                                        "bytesSent",
                                        "bytesStored",
                                        "verdict",
                                        "archivedAs"
                                      ],
                                      "properties": {
                                        "template": {
                                          "type": "string"
                                        },
                                        "kind": {
                                          "type": "string",
                                          "enum": [
                                            "pd",
                                            "ad"
                                          ]
                                        },
                                        "destinationFolderPath": {
                                          "type": "string"
                                        },
                                        "outputFileName": {
                                          "type": "string"
                                        },
                                        "bytesSent": {
                                          "type": [
                                            "integer",
                                            "null"
                                          ]
                                        },
                                        "bytesStored": {
                                          "type": [
                                            "integer",
                                            "null"
                                          ]
                                        },
                                        "verdict": {
                                          "type": "string",
                                          "enum": [
                                            "PASS",
                                            "FAIL",
                                            "CHECK"
                                          ]
                                        },
                                        "verdictNote": {
                                          "type": "string"
                                        },
                                        "missingFields": {
                                          "type": "array"
                                        },
                                        "removed": {
                                          "type": "array"
                                        },
                                        "highlightCleared": {
                                          "type": "integer"
                                        },
                                        "archivedAs": {
                                          "type": "array",
                                          "items": {
                                            "type": "string"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "description": "The schema mirrors pd_tools.py report output. Invalid envelopes are classified separately from agent-declared failures."
                          }
                        },
                        "description": "Scope status is the supported signal for whether ParseJson succeeded."
                      },
                      "FILTER_non_pass_outputs": {
                        "runAfter": {
                          "TRY_parse_agent_report": [
                            "Succeeded"
                          ]
                        },
                        "type": "Query",
                        "inputs": {
                          "from": "@body('PARSE_agent_report')?['outputs']",
                          "where": "@not(equals(item()?['verdict'], 'PASS'))"
                        },
                        "description": "Defence in depth: top-level OK is accepted only when every output independently reports a PASS byte-verification verdict."
                      },
                      "HANDLE_parsed_report": {
                        "runAfter": {
                          "FILTER_non_pass_outputs": [
                            "Succeeded"
                          ]
                        },
                        "type": "If",
                        "expression": {
                          "and": [
                            {
                              "equals": [
                                "@body('PARSE_agent_report')?['status']",
                                "OK"
                              ]
                            },
                            {
                              "greater": [
                                "@length(body('PARSE_agent_report')?['outputs'])",
                                0
                              ]
                            },
                            {
                              "equals": [
                                "@length(body('FILTER_non_pass_outputs'))",
                                0
                              ]
                            }
                          ]
                        },
                        "actions": {
                          "Mark_succeeded": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PatchItem",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                              },
                              "parameters": {
                                "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                                "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                                "id": "@items('For_each_work_item')?['ID']",
                                "item/Status/Value": "Succeeded",
                                "item/AgentResultJson": "@string(body('PARSE_agent_report'))",
                                "item/HasAgentManifest": true,
                                "item/ValidationResult": "Agent status OK; every reported output has verdict PASS and stored byte counts were verified by pd_tools.py.",
                                "item/ErrorMessage": "",
                                "item/CompletedAt": "@utcNow()"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "HANDLE_agent_skipped": {
                              "runAfter": {},
                              "type": "If",
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@body('PARSE_agent_report')?['status']",
                                      "SKIPPED"
                                    ]
                                  },
                                  {
                                    "equals": [
                                      "@body('PARSE_agent_report')?['reason']",
                                      "another-format-preferred"
                                    ]
                                  }
                                ]
                              },
                              "actions": {
                                "Mark_skipped": {
                                  "runAfter": {},
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_sharepointonline",
                                      "operationId": "PatchItem",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                    },
                                    "parameters": {
                                      "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                                      "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                                      "id": "@items('For_each_work_item')?['ID']",
                                      "item/Status/Value": "Failed",
                                      "item/AgentResultJson": "@string(body('PARSE_agent_report'))",
                                      "item/HasAgentManifest": true,
                                      "item/ValidationResult": "Source preference changed after planning; no conversion was produced.",
                                      "item/ErrorMessage": "Publish the same template version again to re-plan the current preferred source.",
                                      "item/CompletedAt": "@utcNow()"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Mark_agent_failed": {
                                    "runAfter": {},
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "connectionName": "shared_sharepointonline",
                                        "operationId": "PatchItem",
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                      },
                                      "parameters": {
                                        "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                                        "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                                        "id": "@items('For_each_work_item')?['ID']",
                                        "item/Status/Value": "Failed",
                                        "item/AgentResultJson": "@string(body('PARSE_agent_report'))",
                                        "item/HasAgentManifest": true,
                                        "item/ValidationResult": "@{concat('Agent status ', body('PARSE_agent_report')?['status'], '; reason=', body('PARSE_agent_report')?['reason'])}",
                                        "item/ErrorMessage": "@{take(coalesce(body('PARSE_agent_report')?['notes'], body('PARSE_agent_report')?['reason']), 4000)}",
                                        "item/CompletedAt": "@utcNow()"
                                      },
                                      "authentication": "@parameters('$authentication')"
                                    },
                                    "description": "Agent-declared failures are parked immediately. A failed report can still describe uploaded or archived files, so automatically invoking the agent again would overwrite the only pre-run recovery chain."
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "Mark_unparseable": {
                        "runAfter": {
                          "TRY_parse_agent_report": [
                            "Failed",
                            "TimedOut"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                            "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                            "id": "@items('For_each_work_item')?['ID']",
                            "item/Status/Value": "Failed",
                            "item/AgentResultJson": "@string(outputs('EXTRACT_reply_text'))",
                            "item/HasAgentManifest": true,
                            "item/ValidationResult": "Agent reply could not be parsed as the contracted JSON report.",
                            "item/ErrorMessage": "@{take(string(outputs('CAPTURE_agent_response')), 4000)}",
                            "item/CompletedAt": "@utcNow()"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "description": "An unreadable envelope is retained verbatim and parked. Retrying could repeat side effects whose archive manifest could not be read."
                      }
                    }
                  },
                  "Handle_processing_failure": {
                    "runAfter": {
                      "Process_document": [
                        "Failed",
                        "TimedOut"
                      ]
                    },
                    "type": "Scope",
                    "actions": {
                      "Detect_backpressure": {
                        "runAfter": {},
                        "type": "If",
                        "expression": {
                          "or": [
                            {
                              "contains": [
                                "@toLower(string(result('Process_document')))",
                                "throttl"
                              ]
                            },
                            {
                              "contains": [
                                "@toLower(string(result('Process_document')))",
                                "429"
                              ]
                            },
                            {
                              "contains": [
                                "@toLower(string(result('Process_document')))",
                                "capacity"
                              ]
                            },
                            {
                              "contains": [
                                "@toLower(string(result('Process_document')))",
                                "quota"
                              ]
                            }
                          ]
                        },
                        "actions": {
                          "Set_backpressure": {
                            "runAfter": {},
                            "type": "SetVariable",
                            "inputs": {
                              "name": "BackpressureHit",
                              "value": true
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        }
                      },
                      "Mark_item_failed_or_retry": {
                        "runAfter": {
                          "Detect_backpressure": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                            "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                            "id": "@items('For_each_work_item')?['ID']",
                            "item/Status/Value": "Failed",
                            "item/AttemptCount": "@add(int(coalesce(items('For_each_work_item')?['AttemptCount'], 0)), 1)",
                            "item/ErrorMessage": "@{take(string(result('Process_document')), 4000)}",
                            "item/CompletedAt": "@utcNow()"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "description": "Every ambiguous invocation failure is parked because the agent may have produced side effects without returning a readable archive manifest. Backpressure still stops remaining items in this batch, but never causes an automatic repeat of the current metered call."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Roll_up_agent_call_count": {
          "runAfter": {
            "For_each_work_item": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
              "table": "@parameters('fi_RunListName (fi_RunListName)')",
              "id": "@first(body('Get_active_run')?['value'])?['ID']",
              "item/AgentCallCount": "@add(int(coalesce(first(body('Get_active_run')?['value'])?['AgentCallCount'], 0)), variables('AgentCallsThisBatch'))"
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "HEADLINE COST METRIC. Flow C reports this against PlannedCount. If agent calls approach the full document count on every run, the cost filters in Flow A are not working, and that - not the flow logic - is where to look."
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
