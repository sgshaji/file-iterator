{
  "$comment": "FLOW A - Plan Regeneration Run. Triggered by a template being published. Resolves affected documents from the index, applies the three cost filters, writes work items, and requests approval. INVOKES THE AGENT ZERO TIMES and writes to no business document. All the cost control in this solution lives here. See docs/Template-Regeneration-Solution-Design.md section 5.",
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "fi_sharedsharepointonline" },
        "api": { "name": "shared_sharepointonline" }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": { "connectionReferenceLogicalName": "fi_sharedapprovals" },
        "api": { "name": "shared_approvals" }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "When_a_template_is_created_or_modified": {
          "type": "OpenApiConnection",
          "recurrence": { "frequency": "Minute", "interval": 5 },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
              "table": "@parameters('fi_LibraryUrlName (fi_LibraryUrlName)')",
              "folderPath": "@parameters('fi_TemplateFolderPath (fi_TemplateFolderPath)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Scoped to the template folder ONLY. The template folder and the output folder must be strictly disjoint, otherwise Flow B's writes re-trigger this flow and the solution regenerates itself in a loop."
        }
      },
      "actions": {
        "GATE_1_Is_this_an_explicit_publish": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "equals": [ "@toLower(coalesce(triggerOutputs()?['body/Status']?['Value'], ''))", "published" ]
          },
          "description": "DEBOUNCE. The modify trigger fires several times for a single human edit - autosave, metadata stamping, check-in. Acting on any modification would regenerate hundreds of documents on a spurious trigger. This flow requires a deliberate publish signal and terminates on anything else.",
          "actions": {
            "Init_TemplateName": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "TemplateName", "type": "string", "value": "@{triggerOutputs()?['body/{FilenameWithExtension}']}" }
                ]
              }
            },
            "Init_RunId": {
              "runAfter": { "Init_TemplateName": ["Succeeded"] },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "RunId", "type": "string", "value": "@{guid()}" }
                ]
              }
            },
            "Init_PlannedCount": {
              "runAfter": { "Init_RunId": ["Succeeded"] },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "PlannedCount", "type": "integer", "value": 0 }
                ]
              }
            },
            "Get_template_content": {
              "runAfter": { "Init_PlannedCount": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetFileContentByPath",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                  "path": "@triggerOutputs()?['body/{FullPath}']",
                  "inferContentType": false
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Compose_template_fingerprint": {
              "runAfter": { "Get_template_content": ["Succeeded"] },
              "type": "Compose",
              "inputs": "@{base64(body('Get_template_content'))}",
              "description": "Fingerprint of the template's substantive content. A hash would be preferable; base64 of the content is used here because Power Automate has no built-in hash function and adding one would require a premium connector, violating R6. Compare fingerprints only, never store this in a report."
            },
            "Get_last_completed_run_for_this_template": {
              "runAfter": { "Compose_template_fingerprint": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                  "table": "@parameters('fi_RunListName (fi_RunListName)')",
                  "$filter": "TemplateName eq '@{variables('TemplateName')}' and (Status eq 'Completed' or Status eq 'CompletedWithErrors')",
                  "$orderby": "Created desc",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "GATE_2_COST_FILTER_F2_Has_the_template_materially_changed": {
              "runAfter": { "Get_last_completed_run_for_this_template": ["Succeeded"] },
              "type": "If",
              "expression": {
                "and": [
                  { "greater": [ "@length(body('Get_last_completed_run_for_this_template')?['value'])", 0 ] },
                  {
                    "equals": [
                      "@first(body('Get_last_completed_run_for_this_template')?['value'])?['TemplateFingerprint']",
                      "@outputs('Compose_template_fingerprint')"
                    ]
                  }
                ]
              },
              "description": "COST FILTER F2. Not every publish changes the output - formatting tweaks, metadata edits and re-saves do not warrant regeneration. If the fingerprint is unchanged the run is abandoned with zero work items and zero cost. This gate alone eliminates the entire spurious-trigger class, which is otherwise the largest single source of wasted spend.",
              "actions": {
                "Terminate_no_material_change": {
                  "runAfter": {},
                  "type": "Terminate",
                  "inputs": { "runStatus": "Succeeded" }
                }
              },
              "else": {
                "actions": {
                  "COST_FILTER_F1_Get_affected_documents": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "GetItems",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                        "table": "@parameters('fi_IndexListName (fi_IndexListName)')",
                        "$filter": "DocumentRole eq 'Source' and IsExcluded eq 0 and startswith(ParentFolderUrl,'@{parameters('fi_RootFolderPath (fi_RootFolderPath)')}')",
                        "$top": 5000
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "description": "COST FILTER F1 - a single INDEXED query against DocumentIndex, not a tree walk. Walking the library on every template change would incur the full enumeration cost every time; this is the whole reason the index exists. Only Source-role rows are candidates, so outputs in the output folder and archived versions are never regenerated."
                  },
                  "Init_AffectedDocuments": {
                    "runAfter": { "COST_FILTER_F1_Get_affected_documents": ["Succeeded"] },
                    "type": "InitializeVariable",
                    "inputs": {
                      "variables": [
                        { "name": "AffectedDocuments", "type": "array", "value": [] }
                      ]
                    }
                  },
                  "For_each_candidate": {
                    "runAfter": { "Init_AffectedDocuments": ["Succeeded"] },
                    "type": "Foreach",
                    "foreach": "@body('COST_FILTER_F1_Get_affected_documents')?['value']",
                    "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
                    "actions": {
                      "Compose_target_url": {
                        "runAfter": {},
                        "type": "Compose",
                        "inputs": "@{items('For_each_candidate')?['ParentFolderUrl']}/@{parameters('fi_OutputFolderName (fi_OutputFolderName)')}/@{replace(items('For_each_candidate')?['FileName'], items('For_each_candidate')?['Extension'], '')} - AD.docx",
                        "description": "Output path derived from the source. The output folder sits alongside the source, matching the existing tree convention."
                      },
                      "Look_up_existing_output": {
                        "runAfter": { "Compose_target_url": ["Succeeded"] },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "GetItems",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                            "table": "@parameters('fi_IndexListName (fi_IndexListName)')",
                            "$filter": "DocumentRole eq 'Output' and TemplateName eq '@{variables('TemplateName')}'",
                            "$top": 1
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "COST_FILTER_F3_Skip_if_already_current": {
                        "runAfter": { "Look_up_existing_output": ["Succeeded"] },
                        "type": "If",
                        "expression": {
                          "and": [
                            { "greater": [ "@length(body('Look_up_existing_output')?['value'])", 0 ] },
                            {
                              "equals": [
                                "@first(body('Look_up_existing_output')?['value'])?['TemplateFingerprint']",
                                "@outputs('Compose_template_fingerprint')"
                              ]
                            }
                          ]
                        },
                        "description": "COST FILTER F3. If the existing output already records this template fingerprint it is current and needs no agent call. This is what makes a re-run after a partial failure cost only the outstanding work, and what makes the whole job idempotent.",
                        "actions": {},
                        "else": {
                          "actions": {
                            "Append_to_affected": {
                              "runAfter": {},
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "AffectedDocuments",
                                "value": {
                                  "SourceUniqueId": "@items('For_each_candidate')?['UniqueId']",
                                  "SourceUrl": "@items('For_each_candidate')?['ServerRelativeUrl']",
                                  "SourceSizeBytes": "@int(coalesce(items('For_each_candidate')?['SizeBytes'], 0))",
                                  "TargetUrl": "@outputs('Compose_target_url')"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "Set_PlannedCount": {
                    "runAfter": { "For_each_candidate": ["Succeeded"] },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "PlannedCount",
                      "value": "@length(variables('AffectedDocuments'))"
                    }
                  },
                  "GATE_3_Exit_if_nothing_to_do": {
                    "runAfter": { "Set_PlannedCount": ["Succeeded"] },
                    "type": "If",
                    "expression": { "equals": [ "@variables('PlannedCount')", 0 ] },
                    "actions": {
                      "Terminate_nothing_affected": {
                        "runAfter": {},
                        "type": "Terminate",
                        "inputs": { "runStatus": "Succeeded" }
                      }
                    },
                    "else": { "actions": {} }
                  },
                  "Create_run_record": {
                    "runAfter": { "GATE_3_Exit_if_nothing_to_do": ["Succeeded"] },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PostItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                        "table": "@parameters('fi_RunListName (fi_RunListName)')",
                        "item/Title": "@variables('RunId')",
                        "item/RunId": "@variables('RunId')",
                        "item/TemplateName": "@variables('TemplateName')",
                        "item/TemplateFingerprint": "@outputs('Compose_template_fingerprint')",
                        "item/TemplateVersion": "@{triggerOutputs()?['body/{VersionNumber}']}",
                        "item/Status/Value": "AwaitingApproval",
                        "item/PlannedCount": "@variables('PlannedCount')",
                        "item/SucceededCount": 0,
                        "item/FailedCount": 0,
                        "item/SkippedCount": 0,
                        "item/AgentCallCount": 0,
                        "item/IsDryRun": "@parameters('fi_DryRun (fi_DryRun)')",
                        "item/RequiresSecondConfirmation": "@greater(variables('PlannedCount'), int(parameters('fi_MaxDocumentsPerRun (fi_MaxDocumentsPerRun)')))",
                        "item/RequestedBy": "@{triggerOutputs()?['body/Editor/Email']}"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "For_each_affected_document": {
                    "runAfter": { "Create_run_record": ["Succeeded"] },
                    "type": "Foreach",
                    "foreach": "@variables('AffectedDocuments')",
                    "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
                    "actions": {
                      "Create_work_item": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PostItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                            "table": "@parameters('fi_WorkItemListName (fi_WorkItemListName)')",
                            "item/Title": "@items('For_each_affected_document')?['SourceUniqueId']",
                            "item/RunId": "@variables('RunId')",
                            "item/SourceUniqueId": "@items('For_each_affected_document')?['SourceUniqueId']",
                            "item/SourceUrl": "@items('For_each_affected_document')?['SourceUrl']",
                            "item/SourceSizeBytes": "@items('For_each_affected_document')?['SourceSizeBytes']",
                            "item/TargetUrl": "@items('For_each_affected_document')?['TargetUrl']",
                            "item/TemplateName": "@variables('TemplateName')",
                            "item/TemplateFingerprint": "@outputs('Compose_template_fingerprint')",
                            "item/Status/Value": "Pending",
                            "item/AttemptCount": 0
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "description": "One durable row per document. Because this state is persisted rather than held in a variable, the job is resumable, its run duration is bounded, and it is immune to the 16 MB action output cap."
                      }
                    }
                  },
                  "GATE_4_Stop_here_if_dry_run": {
                    "runAfter": { "For_each_affected_document": ["Succeeded"] },
                    "type": "If",
                    "expression": { "equals": [ "@parameters('fi_DryRun (fi_DryRun)')", true ] },
                    "description": "DryRun defaults to TRUE so a fresh deployment cannot regenerate documents before anyone has inspected a plan. The work items exist for inspection and are never executed.",
                    "actions": {
                      "Terminate_dry_run_complete": {
                        "runAfter": {},
                        "type": "Terminate",
                        "inputs": { "runStatus": "Succeeded" }
                      }
                    },
                    "else": {
                      "actions": {
                        "GATE_5_Request_approval": {
                          "runAfter": {},
                          "type": "OpenApiConnectionWebhook",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_approvals",
                              "operationId": "StartAndWaitForApproval",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                            },
                            "parameters": {
                              "approvalType": "Basic",
                              "ApprovalCreationInput/title": "@{if(greater(variables('PlannedCount'), int(parameters('fi_MaxDocumentsPerRun (fi_MaxDocumentsPerRun)'))), 'SECOND CONFIRMATION REQUIRED - large regeneration run', 'Approve document regeneration run')}",
                              "ApprovalCreationInput/assignedTo": "@parameters('fi_NotificationRecipient (fi_NotificationRecipient)')",
                              "ApprovalCreationInput/details": "Template: @{variables('TemplateName')}\nRun: @{variables('RunId')}\nDocuments to regenerate: @{variables('PlannedCount')}\nPer-run cap: @{parameters('fi_MaxDocumentsPerRun (fi_MaxDocumentsPerRun)')}\n\n@{if(greater(variables('PlannedCount'), int(parameters('fi_MaxDocumentsPerRun (fi_MaxDocumentsPerRun)'))), 'THIS RUN EXCEEDS THE PER-RUN CAP. Approving it consumes agent capacity for every document listed and overwrites that many business documents. Confirm the correct template was published before approving.', 'Within the configured cap.')}\n\nSample of affected documents:\n@{join(take(variables('AffectedDocuments'), 10), '\n')}"
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "description": "GATE 5 - nothing is written to any business document until a human approves. Above MaxDocumentsPerRun the title and body escalate, which is the circuit breaker against a wrong template becoming a large bill."
                        },
                        "Apply_approval_outcome": {
                          "runAfter": { "GATE_5_Request_approval": ["Succeeded"] },
                          "type": "If",
                          "expression": {
                            "equals": [ "@outputs('GATE_5_Request_approval')?['body/outcome']", "Approve" ]
                          },
                          "actions": {
                            "Mark_run_approved": {
                              "runAfter": {},
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "PatchItem",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                },
                                "parameters": {
                                  "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                                  "table": "@parameters('fi_RunListName (fi_RunListName)')",
                                  "id": "@body('Create_run_record')?['ID']",
                                  "item/Status/Value": "Approved",
                                  "item/ApprovedBy": "@{outputs('GATE_5_Request_approval')?['body/responses'][0]['responder']['email']}",
                                  "item/StartedAt": "@utcNow()"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "description": "Flow B only claims work items belonging to an Approved or Running run. Until this patch happens, the queue is inert."
                            }
                          },
                          "else": {
                            "actions": {
                              "Cancel_run": {
                                "runAfter": {},
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PatchItem",
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                  },
                                  "parameters": {
                                    "dataset": "@parameters('fi_SiteAddress (fi_SiteAddress)')",
                                    "table": "@parameters('fi_RunListName (fi_RunListName)')",
                                    "id": "@body('Create_run_record')?['ID']",
                                    "item/Status/Value": "Cancelled",
                                    "item/CompletedAt": "@utcNow()"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": { "actions": {} }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
