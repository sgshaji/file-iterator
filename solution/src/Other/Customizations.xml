  <environmentvariabledefinitions>
    <environmentvariabledefinition schemaname="fi_SiteAddress">
      <displayname>Site Address</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Site containing the document library. No trailing path beyond the site name.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_LibraryUrlName">
      <displayname>Library URL Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>Shared Documents</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>The library's URL name, which is frequently different from its display name (Documents vs Shared Documents). Use the value in the browser address bar.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_WebServerRelativeUrl">
      <displayname>Web Server-Relative URL</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Server-relative URL of the SharePoint web, with a leading slash and no trailing slash. Prefixes connector trigger tokens, which omit the /sites/&lt;web&gt; segment.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_RootFolderPath">
      <displayname>Root Folder Path</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Server-relative path of the source root. The walk starts here.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_TemplateFolderPath">
      <displayname>Template Folder Path</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Server-relative path of the template folder. MUST be disjoint from the output folder, otherwise the solution's own writes re-trigger Flow A.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_OutputFolderName">
      <displayname>Output Folder Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>AD Documents</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Folder that receives regenerated documents. Never walked as a source, but paths are computed into it.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_ArchiveFolderName">
      <displayname>Archive Folder Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>Archive</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Folder that receives the previous version of every overwritten output. Never walked as a source.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_ExcludedFolderNames">
      <displayname>Excluded Folder Names</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>[&quot;Archive&quot;,&quot;AD Documents&quot;]</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>JSON array of folder names never walked as sources, wherever they appear in the tree. Held as configuration so exclusions can change without editing the flow. Excluded subtrees are dropped before enqueueing, so a subtree of any size costs nothing.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_SourceExtensions">
      <displayname>Source Extensions</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>[&quot;.pdf&quot;,&quot;.docx&quot;]</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>JSON array of lower-case extensions supported by the deployed PD Conversion Assistant skill. Legacy .doc files must be migrated to .docx before entering the source tree.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_BatchSize">
      <displayname>Batch Size</displayname>
      <type>100000001</type>
      <isrequired>1</isrequired>
      <defaultvalue>5</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Documents claimed per Flow B run. THROTTLE 1 OF 2. Set from measured worst-case agent latency, not the average: one slow document stalls a sequential loop. Starts deliberately low for the pilot.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_PlanningPageSize">
      <displayname>Planning Page Size</displayname>
      <type>100000001</type>
      <isrequired>1</isrequired>
      <defaultvalue>200</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>DocumentIndex rows consumed per planner run. Keeps planning below the 16 MB per-action output cap while guaranteeing eventual coverage beyond 5,000 rows.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_MaxDocumentsPerRun">
      <displayname>Max Documents Per Run</displayname>
      <type>100000001</type>
      <isrequired>1</isrequired>
      <defaultvalue>50</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>CIRCUIT BREAKER. Above this count the run is held for a second, deliberate confirmation. Stops a wrong template or a misconfigured filter becoming a large bill.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_StaleClaimMinutes">
      <displayname>Stale Claim Minutes</displayname>
      <type>100000001</type>
      <isrequired>1</isrequired>
      <defaultvalue>60</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Items left InProgress beyond this are reset to Pending at the start of each cycle. Without reaping, a crashed batch strands its claimed items forever.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_WalkFolderChunkSize">
      <displayname>Walk Folder Chunk Size</displayname>
      <type>100000001</type>
      <isrequired>1</isrequired>
      <defaultvalue>100</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Folders processed per Flow E run before re-queueing and exiting. Keeps any single run well inside the duration limit regardless of tree size.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_RollbackPageSize">
      <displayname>Rollback Page Size</displayname>
      <type>100000001</type>
      <isrequired>1</isrequired>
      <defaultvalue>25</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Side-effect manifests restored per rollback worker run.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_DryRun">
      <displayname>Dry Run</displayname>
      <type>100000002</type>
      <isrequired>1</isrequired>
      <defaultvalue>1</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>When true, Flow A plans work items for inspection and the run is never executed. Zero agent cost. DEFAULTS TO TRUE so a fresh deployment cannot regenerate documents before anyone has looked at the plan.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_AgentId">
      <displayname>Agent Schema Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>cree1_pdconversionassistant_08zNQw</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Schema name of the existing PD Conversion Assistant agent invoked through shared_agentnode/InvokeAgent. The agent is referenced, not copied into this solution.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_IndexListName">
      <displayname>Index List Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>DocumentIndex</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Name of the document index list. Parameterised so a test deployment can point at its own copy without touching production data.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_RunListName">
      <displayname>Run List Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>RegenerationRun</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Name of the run header list. Parameterised so a test deployment can point at its own copy without touching production data.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_WorkItemListName">
      <displayname>Work Item List Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>RegenerationWorkItem</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Name of the work queue list. Parameterised so a test deployment can point at its own copy without touching production data.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_WalkFrontierListName">
      <displayname>Walk Frontier List Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>WalkFrontier</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Holds the folder walk frontier. Persisted rather than held in an array variable so the walk is resumable, observable, and immune to the 16 MB action output cap.</description>
    </environmentvariabledefinition>
    <environmentvariabledefinition schemaname="fi_IndexWalkRunListName">
      <displayname>Index Walk Run List Name</displayname>
      <type>100000000</type>
      <isrequired>1</isrequired>
      <defaultvalue>IndexWalkRun</defaultvalue>
      <introducedversion>1.0.0.0</introducedversion>
      <description>Tracks whether a full backfill and stale-row reconciliation completed successfully.</description>
    </environmentvariabledefinition>
  </environmentvariabledefinitions>
</ImportExportXml>
